+                    offset.y + source_rect.bottom - source_rect.top};
+            ID2D1DeviceContext_PushAxisAlignedClip((ID2D1DeviceContext *)iface,
+                    &clip_rect, D2D1_ANTIALIAS_MODE_ALIASED);
+        }
+
+        ID2D1DeviceContext_GetTransform((ID2D1DeviceContext *)iface, &previous_transform);
+        transform = identity;
+        transform._31 = image_rect ? offset.x - source_rect.left : offset.x;
+        transform._32 = image_rect ? offset.y - source_rect.top : offset.y;
+        d2d_matrix_multiply(&transform, &previous_transform);
+        ID2D1DeviceContext_SetTransform((ID2D1DeviceContext *)iface, &transform);
+        hr = d2d_command_list_replay(command_list_impl, (ID2D1DeviceContext *)iface);
+        ID2D1DeviceContext_SetTransform((ID2D1DeviceContext *)iface, &previous_transform);
+        if (image_rect)
+            ID2D1DeviceContext_PopAxisAlignedClip((ID2D1DeviceContext *)iface);
+        ID2D1CommandList_Release(command_list);
+        if (FAILED(hr)) d2d_device_context_set_error(context, hr);
+        return;
+    }
+
     FIXME("Unhandled image %p.\n", image);
 }
 
