+static void d2d_command_list_include_rect(D2D1_RECT_F *bounds, BOOL *has_bounds,
+        const D2D1_RECT_F *rect, const D2D1_MATRIX_3X2_F *transform)
+{
+    D2D1_POINT_2F point;
+    D2D1_RECT_F transformed;
+
+    d2d_point_transform(&point, transform, rect->left, rect->top);
+    transformed.left = transformed.right = point.x;
+    transformed.top = transformed.bottom = point.y;
+    d2d_point_transform(&point, transform, rect->right, rect->top);
+    d2d_rect_expand(&transformed, &point);
+    d2d_point_transform(&point, transform, rect->right, rect->bottom);
+    d2d_rect_expand(&transformed, &point);
+    d2d_point_transform(&point, transform, rect->left, rect->bottom);
+    d2d_rect_expand(&transformed, &point);
+
+    if (!*has_bounds)
+    {
+        *bounds = transformed;
+        *has_bounds = TRUE;
+        return;
+    }
+
+    if (transformed.left < bounds->left) bounds->left = transformed.left;
+    if (transformed.top < bounds->top) bounds->top = transformed.top;
+    if (transformed.right > bounds->right) bounds->right = transformed.right;
+    if (transformed.bottom > bounds->bottom) bounds->bottom = transformed.bottom;
+}
+
+HRESULT d2d_command_list_get_bounds(struct d2d_command_list *command_list,
+        ID2D1DeviceContext *context, D2D1_RECT_F *bounds)
+{
+    D2D1_MATRIX_3X2_F transform = identity;
+    const void *data, *end;
+    BOOL has_bounds = FALSE;
+
+    data = command_list->data;
+    end = (const char *)command_list->data + command_list->size;
+    while (data < end)
+    {
+        const struct d2d_command *command = data;
+        D2D1_RECT_F rect;
+
+        switch (command->op)
+        {
+            case D2D_COMMAND_SET_TRANSFORM:
+                transform = ((const struct d2d_command_set_transform *)data)->transform;
+                break;
+
+            case D2D_COMMAND_DRAW_LINE:
+            {
+                const struct d2d_command_draw_line *c = data;
+                float half_width = c->stroke_width * 0.5f;
+                rect.left = min(c->p0.x, c->p1.x) - half_width;
+                rect.top = min(c->p0.y, c->p1.y) - half_width;
+                rect.right = max(c->p0.x, c->p1.x) + half_width;
+                rect.bottom = max(c->p0.y, c->p1.y) + half_width;
+                d2d_command_list_include_rect(bounds, &has_bounds, &rect, &transform);
+                break;
+            }
+
+            case D2D_COMMAND_DRAW_RECTANGLE:
+            {
+                const struct d2d_command_draw_rectangle *c = data;
+                float half_width = c->stroke_width * 0.5f;
+                rect = c->rect;
+                rect.left -= half_width;
+                rect.top -= half_width;
+                rect.right += half_width;
+                rect.bottom += half_width;
+                d2d_command_list_include_rect(bounds, &has_bounds, &rect, &transform);
+                break;
+            }
+
+            case D2D_COMMAND_FILL_RECTANGLE:
+                rect = ((const struct d2d_command_fill_rectangle *)data)->rect;
+                d2d_command_list_include_rect(bounds, &has_bounds, &rect, &transform);
+                break;
+
+            case D2D_COMMAND_DRAW_GEOMETRY:
+            {
+                const struct d2d_command_draw_geometry *c = data;
+                if (SUCCEEDED(ID2D1Geometry_GetBounds(c->geometry, &transform, &rect)))
+                {
+                    float half_width = c->stroke_width * 0.5f;
+                    rect.left -= half_width;
+                    rect.top -= half_width;
+                    rect.right += half_width;
+                    rect.bottom += half_width;
+                    d2d_command_list_include_rect(bounds, &has_bounds, &rect, &identity);
+                }
+                break;
+            }
+
+            case D2D_COMMAND_FILL_GEOMETRY:
+            {
+                const struct d2d_command_fill_geometry *c = data;
+                if (SUCCEEDED(ID2D1Geometry_GetBounds(c->geometry, &transform, &rect)))
+                    d2d_command_list_include_rect(bounds, &has_bounds, &rect, &identity);
+                break;
+            }
+
+            case D2D_COMMAND_DRAW_BITMAP:
+            {
+                const struct d2d_command_draw_bitmap *c = data;
+                if (c->dst_rect)
+                    rect = *c->dst_rect;
+                else
+                {
+                    D2D1_SIZE_F size = ID2D1Bitmap_GetSize(c->bitmap);
+                    rect = (D2D1_RECT_F){0.0f, 0.0f, size.width, size.height};
+                }
+                d2d_command_list_include_rect(bounds, &has_bounds, &rect, &transform);
+                break;
+            }
+
+            case D2D_COMMAND_DRAW_IMAGE:
+            {
+                const struct d2d_command_draw_image *c = data;
+                if (c->image_rect)
+                    rect = *c->image_rect;
+                else if (FAILED(ID2D1DeviceContext_GetImageLocalBounds(context, c->image, &rect)))
+                    break;
+                if (c->image_rect)
+                {
+                    float width = rect.right - rect.left;
+                    float height = rect.bottom - rect.top;
+                    D2D1_POINT_2F offset = c->target_offset ? *c->target_offset
+                            : (D2D1_POINT_2F){0.0f, 0.0f};
+                    rect = (D2D1_RECT_F){offset.x, offset.y,
+                            offset.x + width, offset.y + height};
+                }
+                else if (c->target_offset)
+                {
+                    rect.left += c->target_offset->x;
+                    rect.top += c->target_offset->y;
+                    rect.right += c->target_offset->x;
+                    rect.bottom += c->target_offset->y;
+                }
+                d2d_command_list_include_rect(bounds, &has_bounds, &rect, &transform);
+                break;
+            }
+
+            case D2D_COMMAND_DRAW_GLYPH_RUN:
+            {
+                const struct d2d_command_draw_glyph_run *c = data;
+                float advance = 0.0f;
+                UINT32 i;
+
+                for (i = 0; i < c->run.glyphCount; ++i)
+                {
+                    float glyph_advance = c->run.glyphAdvances
+                            ? c->run.glyphAdvances[i] : c->run.fontEmSize * 0.5f;
+                    advance += glyph_advance < 0.0f ? -glyph_advance : glyph_advance;
+                }
+                if (c->run.isSideways)
+                    rect = (D2D1_RECT_F){c->origin.x - c->run.fontEmSize,
+                            c->origin.y, c->origin.x + c->run.fontEmSize * 0.25f,
+                            c->origin.y + advance};
+                else
+                    rect = (D2D1_RECT_F){c->origin.x,
+                            c->origin.y - c->run.fontEmSize,
+                            c->origin.x + advance,
+                            c->origin.y + c->run.fontEmSize * 0.25f};
+                d2d_command_list_include_rect(bounds, &has_bounds, &rect, &transform);
+                break;
+            }
+
+            default:
+                break;
+        }
+
+        data = (const char *)data + command->size;
+    }
+
+    if (!has_bounds)
+        *bounds = (D2D1_RECT_F){0};
+    return S_OK;
+}
+
+static BOOL d2d_command_list_fill_image_brush(ID2D1DeviceContext *context,
+        const D2D1_RECT_F *rect, ID2D1Brush *iface)
+{
+    struct d2d_brush *brush = unsafe_impl_from_ID2D1Brush(iface);
+    D2D1_MATRIX_3X2_F transform, previous_transform;
+    ID2D1Bitmap *bitmap;
+
+    if (brush->type != D2D_BRUSH_TYPE_IMAGE)
+        return FALSE;
+    if (SUCCEEDED(ID2D1Image_QueryInterface(brush->u.image.image,
+            &IID_ID2D1Bitmap, (void **)&bitmap)))
+    {
+        ID2D1Bitmap_Release(bitmap);
+        return FALSE;
+    }
+
+    if (brush->opacity != 1.0f || brush->u.image.extend_mode_x != D2D1_EXTEND_MODE_CLAMP
+            || brush->u.image.extend_mode_y != D2D1_EXTEND_MODE_CLAMP)
+        FIXME("Image-brush opacity and non-clamp extend modes are not supported during command-list replay.\n");
+
+    ID2D1DeviceContext_PushAxisAlignedClip(context, rect, D2D1_ANTIALIAS_MODE_ALIASED);
+    ID2D1DeviceContext_GetTransform(context, &previous_transform);
+    transform = brush->transform;
+    d2d_matrix_multiply(&transform, &previous_transform);
+    ID2D1DeviceContext_SetTransform(context, &transform);
+    ID2D1DeviceContext_DrawImage(context, brush->u.image.image, NULL,
+            &brush->u.image.source_rect, brush->u.image.interpolation_mode,
+            D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    ID2D1DeviceContext_SetTransform(context, &previous_transform);
+    ID2D1DeviceContext_PopAxisAlignedClip(context);
+    return TRUE;
+}
+
+HRESULT d2d_command_list_replay(struct d2d_command_list *command_list, ID2D1DeviceContext *context)
+{
+    D2D1_MATRIX_3X2_F base_transform;
+    const void *data, *end;
+
+    if (command_list->state != D2D_COMMAND_LIST_STATE_CLOSED)
+        return D2DERR_WRONG_STATE;
+
+    data = command_list->data;
+    end = (const char *)command_list->data + command_list->size;
+    ID2D1DeviceContext_GetTransform(context, &base_transform);
+    while (data < end)
+    {
+        const struct d2d_command *command = data;
+
+        switch (command->op)
+        {
+            case D2D_COMMAND_SET_ANTIALIAS_MODE:
+                ID2D1DeviceContext_SetAntialiasMode(context,
+                        ((const struct d2d_command_set_antialias_mode *)data)->mode);
+                break;
+            case D2D_COMMAND_SET_TAGS:
+            {
+                const struct d2d_command_set_tags *c = data;
+                ID2D1DeviceContext_SetTags(context, c->tag1, c->tag2);
+                break;
+            }
+            case D2D_COMMAND_SET_TEXT_ANTIALIAS_MODE:
+                ID2D1DeviceContext_SetTextAntialiasMode(context,
+                        ((const struct d2d_command_set_text_antialias_mode *)data)->mode);
+                break;
+            case D2D_COMMAND_SET_TEXT_RENDERING_PARAMS:
+                ID2D1DeviceContext_SetTextRenderingParams(context,
+                        ((const struct d2d_command_set_text_rendering_params *)data)->params);
+                break;
+            case D2D_COMMAND_SET_TRANSFORM:
+            {
+                D2D1_MATRIX_3X2_F transform =
+                        ((const struct d2d_command_set_transform *)data)->transform;
+                d2d_matrix_multiply(&transform, &base_transform);
+                ID2D1DeviceContext_SetTransform(context, &transform);
+                break;
+            }
+            case D2D_COMMAND_SET_PRIMITIVE_BLEND:
+                ID2D1DeviceContext_SetPrimitiveBlend(context,
+                        ((const struct d2d_command_set_primitive_blend *)data)->primitive_blend);
+                break;
+            case D2D_COMMAND_SET_UNIT_MODE:
+                ID2D1DeviceContext_SetUnitMode(context,
+                        ((const struct d2d_command_set_unit_mode *)data)->mode);
+                break;
+            case D2D_COMMAND_CLEAR:
+            {
+                const struct d2d_command_clear *c = data;
+                if (c->color.a != 0.0f)
+                    FIXME("Non-transparent clear is not supported during direct command-list replay.\n");
+                break;
+            }
+            case D2D_COMMAND_DRAW_GLYPH_RUN:
+            {
+                const struct d2d_command_draw_glyph_run *c = data;
+                ID2D1DeviceContext_DrawGlyphRun(context, c->origin, &c->run, c->run_desc,
+                        c->brush, c->measuring_mode);
+                break;
+            }
+            case D2D_COMMAND_DRAW_LINE:
+            {
+                const struct d2d_command_draw_line *c = data;
+                ID2D1DeviceContext_DrawLine(context, c->p0, c->p1, c->brush,
+                        c->stroke_width, c->stroke_style);
+                break;
+            }
+            case D2D_COMMAND_DRAW_GEOMETRY:
+            {
+                const struct d2d_command_draw_geometry *c = data;
+                ID2D1DeviceContext_DrawGeometry(context, c->geometry, c->brush,
+                        c->stroke_width, c->stroke_style);
+                break;
+            }
+            case D2D_COMMAND_DRAW_RECTANGLE:
+            {
+                const struct d2d_command_draw_rectangle *c = data;
+                ID2D1DeviceContext_DrawRectangle(context, &c->rect, c->brush,
+                        c->stroke_width, c->stroke_style);
+                break;
+            }
+            case D2D_COMMAND_DRAW_BITMAP:
+            {
+                const struct d2d_command_draw_bitmap *c = data;
+                ID2D1DeviceContext_DrawBitmap(context, c->bitmap, c->dst_rect, c->opacity,
+                        c->interpolation_mode, c->src_rect, c->perspective_transform);
+                break;
+            }
+            case D2D_COMMAND_DRAW_IMAGE:
+            {
+                const struct d2d_command_draw_image *c = data;
+                ID2D1DeviceContext_DrawImage(context, c->image, c->target_offset, c->image_rect,
+                        c->interpolation_mode, c->composite_mode);
+                break;
+            }
+            case D2D_COMMAND_FILL_MESH:
+            {
+                const struct d2d_command_fill_mesh *c = data;
+                ID2D1DeviceContext_FillMesh(context, c->mesh, c->brush);
+                break;
+            }
+            case D2D_COMMAND_FILL_OPACITY_MASK:
+            {
+                const struct d2d_command_fill_opacity_mask *c = data;
+                ID2D1DeviceContext_FillOpacityMask(context, c->bitmap, c->brush,
+                        c->dst_rect, c->src_rect);
+                break;
+            }
+            case D2D_COMMAND_FILL_GEOMETRY:
+            {
+                const struct d2d_command_fill_geometry *c = data;
+                ID2D1DeviceContext_FillGeometry(context, c->geometry, c->brush, c->opacity_brush);
+                break;
+            }
+            case D2D_COMMAND_FILL_RECTANGLE:
+            {
+                const struct d2d_command_fill_rectangle *c = data;
+                if (!d2d_command_list_fill_image_brush(context, &c->rect, c->brush))
+                    ID2D1DeviceContext_FillRectangle(context, &c->rect, c->brush);
+                break;
+            }
+            case D2D_COMMAND_PUSH_CLIP:
+            {
+                const struct d2d_command_push_clip *c = data;
+                ID2D1DeviceContext_PushAxisAlignedClip(context, &c->rect, c->mode);
+                break;
+            }
+            case D2D_COMMAND_PUSH_LAYER:
+            {
+                const struct d2d_command_push_layer *c = data;
+                ID2D1DeviceContext_PushLayer(context, &c->params, c->layer);
+                break;
+            }
+            case D2D_COMMAND_POP_CLIP:
+                ID2D1DeviceContext_PopAxisAlignedClip(context);
+                break;
+            case D2D_COMMAND_POP_LAYER:
+                ID2D1DeviceContext_PopLayer(context);
+                break;
+            default:
+                FIXME("Unhandled command %u during direct replay.\n", command->op);
+                ID2D1DeviceContext_SetTransform(context, &base_transform);
+                return E_NOTIMPL;
+        }
+
+        data = (const char *)data + command->size;
+    }
+
+    ID2D1DeviceContext_SetTransform(context, &base_transform);
+    return S_OK;
+}
