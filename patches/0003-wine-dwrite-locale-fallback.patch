YMM4M Wine DirectWrite locale fallback patch
Upstream base: db11d0fe6a169c457e23d007e20404643d067aa8
Scope: keep explicit locale mappings separate from the neutral fallback mapping.
Validation: dwrite-font-fallback-reproducer (isolated/shared factories; empty/ja-JP
            locales), Wine layout regression test, YMM4 Lite preview, and a
            10-second H.264/AAC export containing Japanese text.
Removal condition: replace with the upstream Wine fix after the same regression
                   and YMM4 workflows pass without this patch.

diff --git a/dlls/dwrite/analyzer.c b/dlls/dwrite/analyzer.c
index 8548d8515..601be25e5 100644
--- a/dlls/dwrite/analyzer.c
+++ b/dlls/dwrite/analyzer.c
@@ -2764,7 +2764,10 @@ static struct fallback_locale * fallback_builder_add_locale(struct dwrite_fontfa
     struct fallback_locale *locale;
 
     if (!locale_name) locale_name = L"";
-    if ((locale = font_fallback_get_locale(&builder->data.locales, locale_name))) return locale;
+    LIST_FOR_EACH_ENTRY(locale, &builder->data.locales, struct fallback_locale, entry)
+    {
+        if (!wcsicmp(locale->name, locale_name)) return locale;
+    }
     if (!(locale = calloc(1, sizeof(*locale)))) return NULL;
     lstrcpynW(locale->name, locale_name, ARRAY_SIZE(locale->name));
     list_add_tail(&builder->data.locales, &locale->entry);
