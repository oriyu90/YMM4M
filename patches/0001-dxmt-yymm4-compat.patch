+
+    if (next_state == current_context_state_.ptr())
+      return;
+
+    current_context_state_->state() = std::move(state_);
+    state_ = std::move(next_state->state());
+    current_context_state_ = next_state;
+
+    ResetEncodingContextState();
+    RestoreEncodingContextState();
