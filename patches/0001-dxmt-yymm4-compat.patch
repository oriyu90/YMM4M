 namespace dxmt {
 
+/* IDXGISurface2 is exposed only by 2D texture resources. Mapping and GDI
+ * interop remain explicit stubs; D2D consumers can recover the parent D3D11
+ * texture through GetResource without pretending those operations work. */
+template <typename IResource> class MTLDXGISurface : public IDXGISurface2 {
+public:
+  MTLDXGISurface(IResource *resource) : resource_(resource) {}
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid,
+                                           void **object) final {
+    return resource_->QueryInterface(riid, object);
+  }
+  ULONG STDMETHODCALLTYPE AddRef() final { return resource_->AddRef(); }
+  ULONG STDMETHODCALLTYPE Release() final { return resource_->Release(); }
+  HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID guid, UINT size,
+                                           const void *data) final {
+    return resource_->SetPrivateData(guid, size, data);
+  }
+  HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(
+      REFGUID guid, const IUnknown *object) final {
+    return resource_->SetPrivateDataInterface(guid, object);
+  }
+  HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID guid, UINT *size,
+                                           void *data) final {
+    return resource_->GetPrivateData(guid, size, data);
+  }
+  HRESULT STDMETHODCALLTYPE GetParent(REFIID riid, void **parent) final {
+    return GetDevice(riid, parent);
+  }
+  HRESULT STDMETHODCALLTYPE GetDevice(REFIID riid, void **device) final {
+    return resource_->GetDeviceInterface(riid, device);
+  }
+  HRESULT STDMETHODCALLTYPE GetDesc(DXGI_SURFACE_DESC *desc) final {
+    return resource_->GetDXGISurfaceDesc(desc);
+  }
+  HRESULT STDMETHODCALLTYPE Map(DXGI_MAPPED_RECT *, UINT) final {
+    ERR_ONCE("DXGISurface::Map: stub");
+    return E_NOTIMPL;
+  }
+  HRESULT STDMETHODCALLTYPE Unmap() final {
+    ERR_ONCE("DXGISurface::Unmap: stub");
+    return E_NOTIMPL;
+  }
+  HRESULT STDMETHODCALLTYPE GetDC(BOOL, HDC *) final {
+    ERR_ONCE("DXGISurface1::GetDC: stub");
+    return E_NOTIMPL;
+  }
+  HRESULT STDMETHODCALLTYPE ReleaseDC(RECT *) final {
+    ERR_ONCE("DXGISurface1::ReleaseDC: stub");
+    return E_NOTIMPL;
+  }
+  HRESULT STDMETHODCALLTYPE GetResource(REFIID riid, void **resource,
+                                        UINT *subresource) final {
+    if (!resource || !subresource)
+      return E_POINTER;
+    *subresource = 0;
+    return resource_->QueryInterface(riid, resource);
+  }
+
+private:
+  IResource *resource_;
+};
