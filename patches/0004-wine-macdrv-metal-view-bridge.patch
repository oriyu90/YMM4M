+/***********************************************************************
+ *              macdrv_create_metal_view
+ *
+ * Create a Metal view for a Win32 window without exposing the private
+ * macdrv_win_data layout to an external graphics driver.
+ */
+struct macdrv_metal_view_handle
+{
+    struct macdrv_client_surface *surface;
+    macdrv_metal_view view;
+};
+
+DECLSPEC_EXPORT void *macdrv_create_metal_view(HWND hwnd,
+        macdrv_metal_device device, macdrv_metal_layer *layer)
+{
+    struct macdrv_metal_view_handle *handle;
+
+    if (layer) *layer = NULL;
+    if (!(handle = calloc(1, sizeof(*handle)))) return NULL;
+    if ((handle->surface = macdrv_client_surface_create(hwnd)))
+        handle->view = macdrv_view_create_metal_view(handle->surface->cocoa_view, device);
+
+    if (!handle->view)
+    {
+        if (handle->surface) client_surface_release(&handle->surface->client);
+        free(handle);
+        return NULL;
+    }
+    if (layer) *layer = macdrv_view_get_metal_layer(handle->view);
+    return handle;
+}
+
+
+/***********************************************************************
+ *              macdrv_release_metal_view
+ */
+DECLSPEC_EXPORT void macdrv_release_metal_view(void *opaque)
+{
+    struct macdrv_metal_view_handle *handle = opaque;
+
+    if (!handle) return;
+    if (handle->view) macdrv_view_release_metal_view(handle->view);
+    if (handle->surface) client_surface_release(&handle->surface->client);
+    free(handle);
+}
+
